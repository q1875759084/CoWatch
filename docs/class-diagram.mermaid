classDiagram
    %% ── 监听模式新增/改造类 ──
    class WatchSource {
        +Watcher watcher
        -Set~string~ memorySet
        -Set~string~ stabilized
        -Set~string~ inProgress
        -Map~string,int~ lastEnqueueSize
        -WatchJob[] pending
        -boolean running
        +start(folderPath, options)
        +stop()
        -onAddFile(path, size)
        -onChangeFile(path, size)
        -pump()
        -emitEvent(e: WatchEvent)
    }

    class Manifest {
        -string filePath
        +load() Map~string,FileRec~
        +has(path, mtime, size) boolean
        +add(path, mtime, size)
        +save()  %% 原子写: 临时文件 + rename
    }

    class WatchTypes {
        <<interface>> WatchModeOptions
        <<interface>> WatchJob
        <<interface>> WatchStatus
        <<interface>> WatchEvent
        <<interface>> SelectFolderResult
    }

    class Coordinator {
        <<singleton>> recorder/index.ts
        +selectWatchFolder() SelectFolderResult
        +startWatch(roomId, token, folderPath, opts)
        +stopWatch()  %% 关 watcher + pump 继续
        +getWatchStatus() WatchStatus
        +startExternalVideoTranscode(roomId, token, path, onJobDone?)
        -handleExternalTranscodeComplete(...)
        -handleExternalTranscodeError(...)
    }

    %% ── 复用的既有单例（零改动） ──
    class ExternalTranscode {
        <<module singleton>> external-transcode/index.ts
        -ChildProcess ffmpegProcess
        -FSWatcher watcher
        -Set~string~ detectedFiles
        +startExternalTranscode(cfg, cbs)
        +getExternalTranscodeState()
    }

    class Upload {
        <<module singleton>> upload/index.ts
        -string[] uploadQueue
        -boolean isUploading
        -Set~Promise~ activeUploads
        +initUploader(cfg, cbs)
        +enqueueUpload(path)
        +waitForUploadQueue()
        +cleanupUploader()
    }

    class WatchModeSettings {
        <<UI>> WatchModeSettings/index.tsx
        -queue: QueueItem[]
        +onWatchModeEvent(cb)
        +useRoomMeta()
    }

    class QueueRow {
        <<shared UI>> VideoUploader/QueueRow.tsx
    }

    class ElectronVideoUploader {
        <<UI>> ElectronVideoUploader/index.tsx
        +useSharedQueueRow()
    }

    %% ── 关系 ──
    WatchSource ..> Manifest : 三层去重(重启)
    WatchSource ..> WatchTypes : 使用类型
    WatchSource --> Coordinator : 调用 startExternalVideoTranscode(.., onJobDone)
    Coordinator --> ExternalTranscode : 复用(零改动)
    Coordinator --> Upload : 复用(零改动)
    Coordinator ..> WatchTypes : 使用类型
    WatchModeSettings ..> QueueRow : 复用
    ElectronVideoUploader ..> QueueRow : 复用
    WatchModeSettings ..> Coordinator : IPC startWatch/stopWatch/getWatchStatus
    ExternalTranscode ..> Upload : onSegmentReady -> enqueueUpload
