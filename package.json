{
  "name": "cowatch",
  "version": "1.0.0",
  "description": "CoWatch 游戏复盘网站前端",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cowatch.git"
  },
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "type-check": "tsc --noEmit",
    "type-check:electron": "tsc --noEmit --project tsconfig.electron.json",
    "electron:build-main": "webpack --config webpack.electron.js",
    "electron:dev": "npm run electron:build-main && electron .",
    "electron:preview": "npm run electron:build && cross-env ELECTRON_PREVIEW=true electron .",
    "electron:preview:test": "npm run electron:build && cross-env ELECTRON_PREVIEW=true ELECTRON_API_ORIGIN=https://test.cowatch.daibao.site electron .",
    "electron:build": "webpack --config webpack.electron-renderer.js && webpack --config webpack.electron.js",
    "electron:pack": "npm run electron:build && electron-builder --win --publish never",
    "electron:pack:mac": "npm run electron:build && electron-builder --mac --publish never",
    "electron:release": "npm run electron:build && electron-builder --win --publish always"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/node": "20.19.41",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "babel-loader": "9.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "6.10.0",
    "dotenv": "17.4.2",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "html-webpack-plugin": "5.6.7",
    "sass": "1.71.0",
    "sass-loader": "14.2.1",
    "style-loader": "3.3.4",
    "typescript": "5.7.3",
    "webpack": "5.107.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.4",
    "webpack-merge": "6.0.1"
  },
  "dependencies": {
    "@cmjndy/monitor": "^0.1.1",
    "ahooks": "^3.9.7",
    "antd": "^6.4.3",
    "axios": "1.15.2",
    "chokidar": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.6.16",
    "p-retry": "^7.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.1"
  }
}
